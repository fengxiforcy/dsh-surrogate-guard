{
  "name": "dsh-surrogate-guard",
  "version": "0.1.10",
  "private": false,
  "description": "DeepSeek Harness plugin: neutralize lone UTF-16 surrogates before the session log records them, and auto-scan/repair session files that already contain one (prevents permanent 400 INVALID_REQUEST).",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "test"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "unicode",
    "surrogate",
    "utf-16",
    "invalid-request",
    "session-repair"
  ],
  "author": "dsh-surrogate-guard contributors",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "test": "node test/guard.test.mjs && node test/vaccine.test.mjs"
  }
}
